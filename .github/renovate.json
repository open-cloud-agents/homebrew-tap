{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate configuration for Open Cloud Agents Homebrew tap",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "timezone": "Etc/UTC",
  "schedule": ["every weekend"],
  "assignees": ["Ibrahimng"],
  "labels": ["dependencies", "automated"],
  "commitMessagePrefix": "ci(deps):",
  "packageRules": [
    {
      "description": "Group GitHub Actions updates into a consolidated PR",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions-minor-patch",
      "matchUpdateTypes": ["minor", "patch"],
      "commitMessagePrefix": "ci(deps):"
    },
    {
      "description": "Do not manage Homebrew formula urls (automatically managed by release workflow)",
      "matchManagers": ["homebrew"],
      "enabled": false
    },
    {
      "description": "Immediate security and vulnerability updates",
      "matchPackagePatterns": ["*"],
      "matchCurrentVersion": "!/^0/",
      "isVulnerability": true,
      "schedule": ["at any time"],
      "labels": ["security", "dependencies"],
      "assignees": ["Ibrahimng"]
    }
  ]
}
